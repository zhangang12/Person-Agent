{
  "name": "BocomHermes-shell",
  "version": "1.0.0-beta.3",
  "private": true,
  "description": "BocomHermes：一体化桌面主窗口的个人智能体壳（Electron，基于 opencode serve）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --mac",
    "compat": "node scripts/compat-check.mjs",
    "permcheck": "node scripts/permission-probe.mjs",
    "jsonschema": "node scripts/json-schema-probe.mjs",
    "mail:test": "node scripts/mail-parse-selftest.mjs",
    "todo:test": "node scripts/todo-extract-selftest.mjs",
    "tool:test": "node scripts/tool-part-selftest.mjs",
    "compact:test": "node scripts/recorder-compact-selftest.mjs",
    "card:ui:test": "node scripts/card-ui-selftest.mjs",
    "knowledge:test": "node scripts/knowledge-selftest.mjs",
    "cleanup:test": "node scripts/cleanup-detach-test.mjs",
    "scope:test": "node scripts/writescope-selftest.mjs",
    "lsp:test": "node scripts/lsp-smoke.mjs",
    "forkcheck": "node scripts/fork-capability-probe.mjs",
    "readspill:test": "node scripts/electron-node.cjs scripts/read-spill-selftest.mjs",
    "editguard:test": "node scripts/edit-guard-selftest.mjs",
    "ctxguard:test": "node scripts/electron-node.cjs scripts/context-guard-selftest.mjs",
    "agentmd:test": "node scripts/agent-md-selftest.mjs",
    "lspmcp:test": "node scripts/lsp-mcp-selftest.mjs",
    "session:test": "node scripts/session-selftest.mjs",
    "replay:test": "node scripts/replay/run.mjs",
    "orch:test": "node scripts/orch-selftest.mjs",
    "orch:lint": "node scripts/orch-boundary-check.mjs",
    "undef": "node scripts/undef-check.mjs",
    "undef:test": "node scripts/undef-selftest.mjs",
    "inject": "node scripts/inject-check.mjs",
    "inject:test": "node scripts/inject-selftest.mjs",
    "modelroute": "node scripts/model-route-probe.mjs",
    "mcp:browser": "node mcp/browser-mcp.mjs",
    "mcp:browser:test": "node mcp/selftest.mjs",
    "mcpguard:test": "node scripts/mcp-guard-selftest.mjs",
    "mcp:doctor": "node scripts/mcp-doctor.mjs",
    "mcp:httpcap": "node mcp/httpcap-mcp.mjs",
    "mcp:httpcap:test": "node mcp/httpcap-selftest.mjs",
    "mcp:repro": "node mcp/repro-mcp.mjs",
    "mcp:mail": "node mcp/mail-mcp.mjs",
    "mcp:repro:test": "node mcp/repro-selftest.mjs",
    "repro:e2e": "electron scripts/e2e-repro-test.mjs",
    "bars:e2e": "electron scripts/e2e-bars.mjs",
    "mcp:config": "node mcp/print-config.mjs",
    "ui:dev": "node ui-vue/build.mjs --watch",
    "ui:build": "node scripts/electron-node.cjs ui-vue/build.mjs",
    "ui:typecheck": "node scripts/electron-node.cjs node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p ui-vue/tsconfig.json",
    "ui:test": "node scripts/electron-node.cjs node_modules/vitest/vitest.mjs run --config ui-vue/vitest.config.ts",
    "ui:stub": "electron scripts/chat-p2a2-stub.cjs",
    "shot:stub": "electron scripts/shot-stub.cjs",
    "orch:stub": "electron scripts/orch-shard-stub.cjs",
    "run:stub": "electron scripts/run-panel-stub.cjs",
    "bragent:test": "node scripts/browser-agent-selftest.mjs",
    "spin:test": "node scripts/spin-selftest.mjs",
    "dropped:test": "node scripts/dropped-turn-selftest.mjs",
    "split:test": "node scripts/browser-split-selftest.mjs",
    "ref:test": "node scripts/browser-ref-selftest.mjs",
    "type:test": "node scripts/type-verify-selftest.mjs",
    "preview:test": "node scripts/preview-selftest.mjs"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "mysql2": "^3.11.0",
    "pdf-parse": "^1.1.1",
    "pyright": "^1.1.411",
    "typescript": "^5.9.3",
    "typescript-language-server": "^4.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/language-server": "^3.3.8",
    "acorn": "^8.18.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "build": {
    "appId": "com.BocomHermes.shell",
    "productName": "BocomHermes",
    "files": [
      "main.js",
      "preload.js",
      "opencode.js",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "mcp/**/*",
      "plugin/**/*",
      "scripts/fork-capability-probe.mjs",
      "scripts/lsp-smoke.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "mcp/**/*",
      "scripts/fork-capability-probe.mjs",
      "scripts/lsp-smoke.mjs",
      "node_modules/typescript-language-server/**/*",
      "node_modules/typescript/**/*",
      "node_modules/@vue/language-server/**/*",
      "node_modules/@volar/**/*",
      "node_modules/pyright/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BocomHermes"
    },
    "portable": {
      "artifactName": "BocomHermes-便携版-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "BocomHermes ${version}",
      "artifactName": "BocomHermes-${version}-${arch}.dmg"
    }
  }
}
